# DataHub
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_TOKEN=                          # Leave empty for local no-auth setup

# GitHub
GITHUB_TOKEN=                           # Personal access token (repo read scope)
GITHUB_REPO_OWNER=                      # e.g. "my-org"
GITHUB_REPO_NAME=                       # e.g. "data-platform"

# LLM (Groq - free)
GROQ_API_KEY=                           # From console.groq.com
GROQ_MODEL=llama-3.3-70b-versatile

# App
BACKEND_PORT=8000
FRONTEND_PORT=3000
